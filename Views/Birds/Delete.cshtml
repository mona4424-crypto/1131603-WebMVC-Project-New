@model project.Models.Bird

@{
    ViewData["Title"] = "刪除鳥ㄋㄧㄠ";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-danger text-white py-3">
            <h4 class="mb-0 fw-bold">刪除鳥ㄋㄧㄠ資料</h4>
        </div>

        <div class="card-body p-4">
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <img src="@Model.ImagePath"
                         class="img-fluid rounded shadow-sm w-100"
                         style="max-height: 300px; object-fit: cover;"
                         alt="@Model.BirdName" />
                </div>

                <div class="col-md-8">
                    <h3 class="fw-bold">@Model.BirdName</h3>
                    <h5 class="text-muted mb-3">@Model.EnglishName</h5>

                    <hr class="text-secondary" />

                    <div class="mb-2">
                        <strong>種類：</strong>
                        <span>@Model.Category</span>
                    </div>

                    <div class="mb-2">
                        <strong>出沒地點：</strong>
                        <span>@Model.FoundLocation</span>
                    </div>

                    <div class="mb-2">
                        <strong>介紹：</strong>
                        <p class="mt-1 text-break text-muted">@Model.Description</p>
                    </div>
                </div>
            </div>

            <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                <div>
                    <strong>注意：</strong> 刪除後資料將無法復原！
                </div>
            </div>

            <form asp-action="Delete" class="d-flex gap-2">
                <input type="hidden" asp-for="BirdID" />

                <button type="submit" class="btn btn-danger px-4">
                    確認刪除
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    返回圖鑑
                </a>
            </form>
        </div>
    </div>
</div>