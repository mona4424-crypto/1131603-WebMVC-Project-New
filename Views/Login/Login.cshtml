@model project.ViewModel.LoginViewModel



<style>
    
    .login-page-container {
        display: flex;
        justify-content: center;
        
        padding: 20px 20px; 
    }

    
    .login-wrapper {
        display: flex;
        background-color: #3b5f8a;
        width: 100%;
        max-width: 1100px; 
        min-height: 600px; 
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        overflow: hidden;
    }

   
    .login-form-section {
        width: 45%;
        padding: 50px;
        display: flex;
        flex-direction: column;
        color: #ffffff;
    }

    .logo-area {
        margin-bottom: 30px;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .logo-circle {
        width: 60px;
        height: 60px;
        background-color: #fff;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: bold;
        color: #3b5f8a;
        font-size: 12px;
        text-align: center;
        line-height: 1.2;
    }

    .input-group {
        position: relative;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        background: #fff;
        border-radius: 4px;
        padding: 5px 15px;
    }

        .input-group span {
            color: #555;
            font-size: 18px;
            margin-right: 10px;
        }

        .input-group input {
            border: none;
            outline: none;
            width: 100%;
            height: 40px; 
            font-size: 15px;
            color: #333;
        }

    .submit-btn {
        width: 100%;
        padding: 14px;
        margin-top: 15px;
        background-color: #1a1a1a;
        color: #fff;
        border: none;
        border-radius: 4px;
        font-size: 16px;
        cursor: pointer;
        transition: background 0.3s;
    }

        .submit-btn:hover {
            background-color: #333;
        }

    .lang-switch {
        text-align: right;
        margin-top: 10px;
        font-size: 13px;
    }

        .lang-switch a {
            color: #ccc;
            text-decoration: none;
            margin: 0 5px;
        }

            .lang-switch a.active, .lang-switch a:hover {
                color: #fff;
                font-weight: bold;
            }

    
    .hint-text {
        margin-top: auto; 
        font-size: 12px;
        color: #d0dbe6;
        line-height: 1.6;
    }

    .error-message {
        color: #ff6b6b;
        font-size: 14px;
        margin-top: 15px;
        text-align: center;
    }

    .login-image-section {
        width: 55%;
        padding: 20px 20px 20px 0;
        position: relative;
    }

    .image-container {
        width: 100%;
        height: 100%;
        border-radius: 120px 15px 15px 15px;
       
        background: url('/images/yzu_bird.jpg') no-repeat center center;
        background-color: #2c4566; 
        background-size: cover;
        position: relative;
        box-shadow: -5px 5px 15px rgba(0,0,0,0.2);
    }

  
    .vertical-text {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        writing-mode: vertical-rl;
        text-orientation: mixed;
        color: rgba(255, 255, 255, 0.85);
        font-size: 54px;
        font-weight: 900;
        letter-spacing: 15px;
        font-family: "Arial Black", sans-serif;
        pointer-events: none;
        text-shadow: 2px 2px 8px rgba(0,0,0,0.3);
    }
</style>

<div class="login-page-container">
    <div class="login-wrapper">
        <div class="login-form-section">
            <div class="logo-area">
                <div class="logo-circle">
                    YZU<br />BIRD
                </div>
                
            </div>

            <form asp-action="Login" method="post">
                <div class="input-group">
                    <span></span>
                    <input asp-for="Account" placeholder="帳號 (例：Bird)" autocomplete="off" />
                </div>

                <div class="input-group">
                    <span></span>
                    <input asp-for="Password" type="password" placeholder="密碼(例：686)" />
                </div>

                <button type="submit" class="submit-btn">登 入</button>
            </form>

            

            @if (!string.IsNullOrEmpty(ViewBag.Message))
            {
                <div class="error-message">
                    @ViewBag.Message
                </div>
            }

            <div class="hint-text">
                <p>帳號：輸入您的圖鑑帳號，如 Bird。</p>
                <p>密碼：輸入預設密碼（冷知識：台灣有紀錄的鳥種約 686 種上下）</p>
                <br />
               
            </div>
        </div>

        <div class="login-image-section">
            <div class="image-container">
                <div class="vertical-text">
                   BIRDTAL
                </div>
            </div>
        </div>
    </div>
</div>